# GEMINI_API_KEY: Required for Gemini AI API calls (e.g., AI bundle recommendations & copy generation)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (or your Vercel deployment URL)
APP_URL="https://bundle-app-one.vercel.app"

# SHOPIFY_API_KEY: Shopify App Client ID from Shopify Partner Dashboard
SHOPIFY_API_KEY="your_shopify_client_id"

# SHOPIFY_API_SECRET: Shopify App Client Secret for HMAC signature and token exchange
SHOPIFY_API_SECRET="your_shopify_client_secret"

# SHOPIFY_SCOPES: Permissions required by the Shopify app
SHOPIFY_SCOPES="read_products,write_products,read_orders,write_draft_orders,read_themes,write_themes"

